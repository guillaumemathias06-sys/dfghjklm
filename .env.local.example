# Supabase — Project Settings > API (Data API / API Keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role — SERVEUR UNIQUEMENT (synchronisation Playtomic).
SUPABASE_SERVICE_ROLE_KEY=

# Secret des tâches planifiées Vercel (vercel.json) : une longue chaîne aléatoire.
CRON_SECRET=

# Playtomic — API tierce en lecture seule. Client ID, secret et identifiant du club (tenant_id).
# À saisir directement dans Vercel, jamais dans un message ni un fichier commité.
PLAYTOMIC_CLIENT_ID=
PLAYTOMIC_CLIENT_SECRET=
PLAYTOMIC_TENANT_ID=
